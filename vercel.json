{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/work/messa",
      "destination": "https://messa.alevizio.com",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "alejandrovizio.com" }],
      "destination": "https://alevizio.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "alejandrovizio.com" }],
      "destination": "https://alevizio.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.alejandrovizio.com" }],
      "destination": "https://alevizio.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.alejandrovizio.com" }],
      "destination": "https://alevizio.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.alevizio.com" }],
      "destination": "https://alevizio.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.alevizio.com" }],
      "destination": "https://alevizio.com/:path*",
      "permanent": true
    }
  ]
}
